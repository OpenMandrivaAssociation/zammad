RAILS_ENV=production
RAILS_LOG_TO_STDOUT=true
REDIS_URL=unix:///run/redis/zammad/redis.sock
ZAMMAD_BIND_IP=127.0.0.1
ZAMMAD_RAILS_PORT=3000
ZAMMAD_WEBSOCKET_PORT=6042
RAILS_TRUSTED_PROXIES=127.0.0.1,::1
WEBSOCKET_SERVER_LOG_TO_STDOUT=true
BACKGROUND_SERVICES_LOG_TO_STDOUT=true
BUNDLE_GEMFILE=/srv/www/zammad/Gemfile
